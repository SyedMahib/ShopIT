# Copy this file to config.env and fill in your values.
# config.env is ignored by git - never commit real secrets.

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# MongoDB: local database for development, hosted one (e.g. Atlas) for production
DB_LOCAL_URI=mongodb://127.0.0.1:27017/shopit
DB_URI=

# Auth (use a long random string for JWT_SECRET)
JWT_SECRET=
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email (password reset, order updates, contact form)
# Development: a Mailtrap sandbox inbox. Production: a transactional provider (Brevo, Resend, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ShopIT
# Where contact form messages go (defaults to SMTP_FROM_EMAIL)
CONTACT_EMAIL=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image uploads (cloudinary.com > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Card payments (dashboard.stripe.com > Developers > API keys). Leave empty to offer cash on delivery only.
# Webhook secret: printed by `stripe listen` in development (command in README),
# or the endpoint you add under Developers > Webhooks in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
